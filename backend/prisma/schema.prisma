generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ApplicationRole {
  REQUESTER
  ACCOUNT_APPROVER
  OU_ADMIN
  SECURITY_REVIEWER
  PROVISIONER
  ORGANISATION_ADMIN
  PLATFORM_ADMIN
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ScopeType {
  TENANT
  AWS_ORGANISATION
  ORGANISATIONAL_UNIT
  AWS_ACCOUNT
}

enum AccountType {
  MANAGEMENT
  SECURITY
  LOG_ARCHIVE
  SHARED_SERVICES
  NETWORK
  PRODUCTION
  STAGING
  DEVELOPMENT
  SANDBOX
  EXTERNAL
}

enum ConnectionType {
  LOCAL_DEFAULT_CREDENTIALS
  ACCESS_KEYS
  DEFAULT_CHAIN
  ASSUME_ROLE
  EXTERNAL_ROLE
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  DEGRADED
  DISABLED
  DISCONNECTED
  ERROR
}

enum AwsAccountSource {
  MANUAL
  ORGANISATION_DISCOVERY
  DEMO_SEED
  MIGRATION
  LEGACY
}

enum TargetType {
  USER
  ROLE
  IDENTITY_CENTER_USER
  IDENTITY_CENTER_GROUP
  IAM_GROUP
}

enum RequestStatus {
  DRAFT
  PENDING_APPROVAL
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  PROVISIONING
  PROVISIONED
  PROVISIONING_FAILED
  EXPIRED
  REVOKED
}

enum RequestMode {
  MANAGED_POLICY
  SPECIFIC_ACTIONS
  PERMISSION_SET
}

enum ProvisioningMode {
  MOCK
  SIMULATE
  LIVE
  MANUAL
}

model User {
  id                String                 @id @default(uuid())
  email             String                 @unique
  displayName       String
  legacyRole        String?
  status            UserStatus             @default(ACTIVE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  lastLoginAt       DateTime?
  activeTenantId    String?
  activeAwsAccountRecordId String?
  identities        AuthIdentity[]
  memberships       TenantMembership[]
  principalMappings AwsPrincipalMapping[]
  requestedRequests Request[]              @relation("RequestRequester")
  connectionEvents  ConnectionAuditEvent[]
  developmentRoleGrants DevelopmentRoleGrant[] @relation("DevelopmentRoleGrantUser")
  grantedDevelopmentRoles DevelopmentRoleGrant[] @relation("DevelopmentRoleGrantActor")
}

model AuthIdentity {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  providerSubject String
  providerEmail   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Tenant {
  id               String                 @id @default(uuid())
  name             String
  slug             String                 @unique
  status           String                 @default("ACTIVE")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  memberships      TenantMembership[]
  organisations    AwsOrganisation[]
  accounts         AwsAccount[]
  approvalPolicies ApprovalPolicy[]
  requests         Request[]
  connectionEvents ConnectionAuditEvent[]
  accountConnections AwsAccountConnection[]
  developmentRoleGrants DevelopmentRoleGrant[]
}

model TenantMembership {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ApplicationRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  adminScopes AdminScope[]

  @@unique([tenantId, userId])
  @@index([userId])
}

model AwsOrganisation {
  id                  String                  @id @default(uuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisationId      String
  organisationName    String
  managementAccountId String
  connectionStatus    ConnectionStatus        @default(PENDING)
  lastSyncedAt        DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  isDemo              Boolean                 @default(false)
  sourceType          AwsAccountSource        @default(LEGACY)
  organisationalUnits AwsOrganisationalUnit[]
  accounts            AwsAccount[]
  requests            Request[]

  @@unique([tenantId, organisationId])
}

model AwsOrganisationalUnit {
  id                String          @id @default(uuid())
  awsOrganisationId String
  awsOrganisation   AwsOrganisation @relation(fields: [awsOrganisationId], references: [id], onDelete: Cascade)
  ouId              String
  parentOuId        String?
  name              String
  fullPath          String
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  isDemo            Boolean         @default(false)
  sourceType        AwsAccountSource @default(LEGACY)
  accounts          AwsAccount[]
  requests          Request[]

  @@unique([awsOrganisationId, ouId])
}

model AwsAccount {
  id                        String                 @id @default(uuid())
  tenantId                  String
  tenant                    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  awsOrganisationId         String?
  awsOrganisation           AwsOrganisation?       @relation(fields: [awsOrganisationId], references: [id])
  ouId                      String?
  organisationalUnit        AwsOrganisationalUnit? @relation(fields: [ouId], references: [id])
  accountId                 String
  accountName               String
  accountEmail              String?
  accountType               AccountType
  environment               String
  riskTier                  String
  region                    String
  connectionType            ConnectionType
  connectionStatus          ConnectionStatus       @default(PENDING)
  executionRoleArn          String?
  readRoleArn               String?
  provisionRoleArn          String?
  externalIdSecretReference String?
  sourceType                 AwsAccountSource       @default(LEGACY)
  isDemo                     Boolean                @default(false)
  discoveredAt               DateTime?
  manuallyCreatedAt          DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  principalMappings         AwsPrincipalMapping[]
  requests                  Request[]
  connectionEvents          ConnectionAuditEvent[]
  grants                    PermissionGrant[]
  connection                AwsAccountConnection?
  developmentRoleGrants     DevelopmentRoleGrant[]

  @@unique([tenantId, accountId])
  @@index([awsOrganisationId, ouId])
}

model AwsAccountConnection {
  id                            String      @id @default(uuid())
  tenantId                      String
  tenant                        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  awsAccountId                  String      @unique
  awsAccount                    AwsAccount  @relation(fields: [awsAccountId], references: [id], onDelete: Cascade)
  connectionType                String
  connectionSource              AwsAccountSource @default(LEGACY)
  readRoleArn                   String?
  provisionRoleArn              String?
  externalIdSecretReference     String?
  accessKeyIdEncrypted          String?
  secretAccessKeyEncrypted      String?
  sessionTokenEncrypted         String?
  accessKeyIdMasked             String?
  credentialUpdatedAt           DateTime?
  organisationDiscoveryRoleArn  String?
  defaultRegion                 String
  organisationsRegion           String      @default("us-east-1")
  connectionStatus              String      @default("PENDING")
  provisioningStatus            String      @default("DISABLED")
  provisioningEnabled           Boolean     @default(false)
  provisionRoleStatus           String      @default("NOT_VALIDATED")
  provisionRoleLastValidatedAt  DateTime?
  provisionRoleLastError        String?
  lastValidatedAt               DateTime?
  lastSuccessfulReadAt          DateTime?
  lastSuccessfulProvisionAt     DateTime?
  lastErrorCode                 String?
  lastErrorMessage              String?
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt

  @@unique([tenantId, awsAccountId])
  @@index([tenantId, connectionStatus])
}

model AdminScope {
  id                     String           @id @default(uuid())
  tenantMembershipId     String
  tenantMembership       TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)
  scopeType              ScopeType
  scopeId                String
  includeDescendants     Boolean          @default(true)
  canView                Boolean          @default(true)
  canRequest             Boolean          @default(false)
  canApprove             Boolean          @default(false)
  canProvision           Boolean          @default(false)
  canRevoke              Boolean          @default(false)
  canManageConfiguration Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([tenantMembershipId, scopeType, scopeId])
  @@index([scopeType, scopeId])
}

model ApprovalPolicy {
  id                           String       @id @default(uuid())
  tenantId                     String
  tenant                       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                         String
  accountType                  AccountType?
  riskTier                     String?
  permissionRisk               String?
  maximumDuration              Int?
  permanentAccessAllowed       Boolean      @default(false)
  automaticProvisioningAllowed Boolean      @default(false)
  requiredApprovalStages       Json
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  requests                     Request[]

  @@index([tenantId, accountType, riskTier])
}

model AwsPrincipalMapping {
  id                    String     @id @default(uuid())
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  awsAccountId          String
  awsAccount            AwsAccount @relation(fields: [awsAccountId], references: [id], onDelete: Cascade)
  principalType         TargetType
  principalArn          String
  identityCenterUserId  String?
  identityCenterGroupId String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([userId, awsAccountId, principalArn])
}

model Request {
  id                     String                 @id
  title                  String
  tenantId               String?
  tenant                 Tenant?                @relation(fields: [tenantId], references: [id])
  awsOrganisationId      String?
  awsOrganisation        AwsOrganisation?       @relation(fields: [awsOrganisationId], references: [id])
  ouId                   String?
  organisationalUnit     AwsOrganisationalUnit? @relation(fields: [ouId], references: [id])
  awsAccountId           String?
  awsAccount             AwsAccount?            @relation(fields: [awsAccountId], references: [id])
  accountType            AccountType?
  requesterUserId        String?
  requesterUser          User?                  @relation("RequestRequester", fields: [requesterUserId], references: [id])
  requester              String
  approver               String
  approverUserId         String?
  targetSubjectType      TargetType?
  targetType             TargetType
  targetName             String
  targetArn              String
  permissionSource       String?
  scope                  Json
  duration               String
  startDate              DateTime
  expiryDate             DateTime?
  priority               String
  justification          String
  notes                  String?
  approvalPolicyId       String?
  approvalPolicy         ApprovalPolicy?        @relation(fields: [approvalPolicyId], references: [id])
  requiredApprovalStages Json?
  completedApprovalStages Json?
  provisioningAccountId  String?
  provisioningRoleArn    String?
  status                 RequestStatus          @default(DRAFT)
  submittedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  items                  RequestItem[]
  approvals              Approval[]
  grants                 PermissionGrant[]
  jobs                   ProvisioningJob[]
  auditEvents            AuditEvent[]

  @@index([tenantId, awsAccountId, status])
  @@index([requesterUserId])
}

model RequestItem {
  id                      String      @id @default(uuid())
  requestId               String
  request                 Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  mode                    RequestMode
  policyArn               String?
  policyName              String?
  actions                 String[]
  generatedPolicyDocument Json?
}

model Approval {
  id             String   @id @default(uuid())
  requestId      String
  request        Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stage          String   @default("ACCOUNT_APPROVER")
  approverUserId String?
  approver       String
  decision       String
  comment        String
  createdAt      DateTime @default(now())

  @@index([requestId, stage])
}

model PermissionGrant {
  id                   String      @id @default(uuid())
  requestId            String
  request              Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  awsAccountId         String?
  awsAccount           AwsAccount? @relation(fields: [awsAccountId], references: [id])
  targetType           TargetType
  targetName           String
  targetArn            String
  policyArn            String
  attachedAt           DateTime
  activatedAt          DateTime?
  expiresAt            DateTime?
  grantedPolicyArn     String?
  revocationStatus     String      @default("PENDING")
  scheduledRevocationId String?
  provisioningResponse Json
  revocationResponse   Json?
  revokedAt            DateTime?

  @@index([requestId])
  @@index([awsAccountId, targetArn, policyArn])
}

model DevelopmentRoleGrant {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation("DevelopmentRoleGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  awsAccountId String
  awsAccount   AwsAccount      @relation(fields: [awsAccountId], references: [id], onDelete: Cascade)
  role         ApplicationRole
  grantedById  String
  grantedBy    User            @relation("DevelopmentRoleGrantActor", fields: [grantedById], references: [id])
  createdAt    DateTime        @default(now())
  revokedAt    DateTime?

  @@unique([tenantId, userId, awsAccountId, role])
  @@index([tenantId, awsAccountId, userId])
}

model ProvisioningJob {
  id          String           @id @default(uuid())
  requestId   String
  request     Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  mode        ProvisioningMode
  operation   String
  status      String
  response    Json?
  error       String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
}

model AuditEvent {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  actor         String
  actorUserId   String?
  tenantId      String?
  requestId     String?
  request       Request? @relation(fields: [requestId], references: [id])
  awsAccountId  String?
  targetArn     String?
  policyArn     String?
  action        String
  previousState Json?
  newState      Json?
  result        String
  errorCode     String?
  awsRequestId  String?

  @@index([timestamp])
  @@index([tenantId, awsAccountId])
  @@index([requestId])
}

model ConnectionAuditEvent {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  awsAccountId String?
  awsAccount   AwsAccount? @relation(fields: [awsAccountId], references: [id])
  actorUserId  String
  actorUser    User        @relation(fields: [actorUserId], references: [id])
  action       String
  outcome      String
  metadata     Json
  createdAt    DateTime    @default(now())

  @@index([tenantId, createdAt])
}

model ApplicationSettings {
  id                       String   @id @default("permissionhub")
  provisioningMode         String   @default("MOCK")
  enableLiveProvisioning   Boolean  @default(false)
  liveConfirmationProvided Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}
