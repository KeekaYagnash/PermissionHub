NODE_ENV=
PORT=
DATABASE_URL=
ENABLE_RUNTIME_DEBUG=
BUILD_COMMIT=
REDIS_URL=
AUTH_ENABLED=
ENABLE_DEV_AUTH=
DEV_AUTH_USER_ID=
SESSION_SECRET=
SESSION_COOKIE_NAME=
FRONTEND_URL=
AWS_PROFILE=
AWS_REGION=
PERMISSIONHUB_CREDENTIAL_ENCRYPTION_KEY=
AWS_CONNECTION_MODE=
ENABLE_AWS_DEMO_DATA=
AWS_ORGANISATIONS_DISCOVERY_ENABLED=
AWS_ASSUME_ROLE_DURATION_SECONDS=
AWS_ROLE_CACHE_TTL_SECONDS=
PROVISIONING_MODE=
AWS_PROVISIONING_MODE=
ENABLE_LIVE_PROVISIONING=
PROVISIONING_CONFIRMATION=
CROSS_ACCOUNT_PROVISIONING_ENABLED=
ALLOW_DEV_SELF_APPROVAL=
ALLOW_LOCAL_PROVISIONING=
AWS_LIVE_TEST_ALLOWED_PRINCIPALS=
EXPIRY_REVOCATION_MODE=
# Existing SES identities are in us-east-1, independently of APP_AWS_REGION.
INVITATION_EMAIL_MODE=disabled
NOTIFICATION_EMAIL_MODE=disabled
SES_REGION=us-east-1
SES_FROM_EMAIL=no-reply@disraptor.co.za
# Set to the matching EXISTING verified us-east-1 domain identity. An info@ email identity is not sufficient.
# Only disraptor-internal.net domain verification is supported by the evidence supplied so far.
# For that existing domain, select SES_FROM_EMAIL=no-reply@disraptor-internal.net and its domain identity ARN.
SES_IDENTITY_ARN=
