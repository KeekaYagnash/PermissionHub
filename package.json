{
  "name": "permissionhub",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "eslint backend/src backend/prisma frontend/src",
    "seed": "npm run seed -w backend",
    "aws:whoami": "npm run aws:whoami -w backend",
    "aws:validate-account": "npm run aws:validate-account -w backend --"
    ,"aws:clear-demo-data": "npm run aws:clear-demo-data -w backend --"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.65.0"
  }
}
