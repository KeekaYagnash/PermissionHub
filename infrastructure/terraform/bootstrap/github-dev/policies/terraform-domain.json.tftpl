{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCloudflareDevCredential",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:af-south-1:${account_id}:secret:Cloudflare/IAMOps-OHd0cA"
    },
    {
      "Sid": "DiscoverCertificates",
      "Effect": "Allow",
      "Action": "acm:ListCertificates",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "RequestDevFrontendCertificate",
      "Effect": "Allow",
      "Action": "acm:RequestCertificate",
      "Resource": "arn:aws:acm:us-east-1:${account_id}:certificate/*",
      "Condition": {"ForAllValues:StringEquals": {"acm:DomainNames": ["dev.iamops.disraptor.co.za"]}, "Null": {"acm:DomainNames": "false"}, "StringEquals": {"acm:ValidationMethod": "DNS", "aws:RequestTag/Application": "PermissionHub", "aws:RequestTag/Environment": "dev"}}
    },
    {
      "Sid": "ReadCertificate",
      "Effect": "Allow",
      "Action": ["acm:DescribeCertificate", "acm:ListTagsForCertificate"],
      "Resource": "arn:aws:acm:us-east-1:${account_id}:certificate/*"
    },
    {
      "Sid": "TagNewDevCertificate",
      "Effect": "Allow",
      "Action": "acm:AddTagsToCertificate",
      "Resource": "arn:aws:acm:us-east-1:${account_id}:certificate/*",
      "Condition": {"StringEquals": {"aws:RequestTag/Application": "PermissionHub", "aws:RequestTag/Environment": "dev"}}
    },
    {
      "Sid": "MaintainDevCertificate",
      "Effect": "Allow",
      "Action": ["acm:AddTagsToCertificate", "acm:RemoveTagsFromCertificate", "acm:DeleteCertificate"],
      "Resource": "arn:aws:acm:us-east-1:${account_id}:certificate/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Application": "PermissionHub", "aws:ResourceTag/Environment": "dev"}}
    }
  ]
}
